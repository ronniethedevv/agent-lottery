# ─────────────────────────────────────────────────────────────
# Agent Lottery — environment configuration
# Copy to `.env` and fill in. Never commit the real `.env`.
# ─────────────────────────────────────────────────────────────

# ── Chain / RPC ──────────────────────────────────────────────
BSC_RPC_URL=https://bsc-dataseed1.binance.org/
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545/

# ── Deployment (contracts) ───────────────────────────────────
# Private key used by hardhat-deploy to deploy the contracts.
DEPLOYER_PRIVATE_KEY=
# Receives the protocol fee (defaults to the deployer if unset).
PROTOCOL_TREASURY=

# Chainlink VRF V2.5 — create a subscription at vrf.chain.link and
# add the DrawManager as a consumer after deploying.
VRF_COORDINATOR=0xc587d9053cd1118f25F645F9E08BB98c9712A4EE
VRF_KEY_HASH=0x114f3da0a805b6a67d6e9cd2ec746f7028f1b7376365af575cfea3550dd1aa04
VRF_SUBSCRIPTION_ID=
VRF_COORDINATOR_TESTNET=0xDA3b641D438362C440Ac5458c57e00a712b66700
VRF_KEY_HASH_TESTNET=0x8596b430971ac45bdf6088665b9ad8e8630c9d5049ab54b14dff711bee7c0e26
VRF_SUBSCRIPTION_ID_TESTNET=

# ── Deployed contract addresses ──────────────────────────────
# `pnpm --filter @agent-lottery/contracts deploy:testnet` writes
# packages/contracts/deployments.json automatically (the agent reads it).
# These env vars are only needed as a fallback / for the backend indexer.
AGENT_REGISTRY_ADDRESS=
LOTTERY_FACTORY_ADDRESS=
DRAW_MANAGER_ADDRESS=
PRIZE_POOL_ADDRESS=
ELIGIBILITY_VERIFIER_ADDRESS=
TICKET_VERIFIER_ADDRESS=
CLAIM_VERIFIER_ADDRESS=
LOTTERY_IMPLEMENTATION_ADDRESS=

# ── Agent runtime ────────────────────────────────────────────
# BIP-39 mnemonic; agents use derived wallets 0,1,2… Each must hold BNB
# for gas + the 0.1 BNB stake + entry fees. (Can also be set in agents.yaml.)
AGENT_MNEMONIC=
AGENT_COUNT=5
AGENT_TICK_INTERVAL_MS=30000

# ── Backend (API + indexer) ──────────────────────────────────
DATABASE_URL=postgresql://localhost:5432/agent_lottery
PORT=3001
# Block to start indexing from — set to the deploy block (printed by the
# deploy script as INDEX_START_BLOCK) so backfill isn't slow.
INDEX_START_BLOCK=0
INDEX_POLL_INTERVAL=5000
CORS_ORIGIN=http://localhost:3000

# ── Frontend ─────────────────────────────────────────────────
# The backend serves REST and WebSocket on the SAME port (PORT above).
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001
NEXT_PUBLIC_BSC_RPC_URL=https://bsc-dataseed1.binance.org/
